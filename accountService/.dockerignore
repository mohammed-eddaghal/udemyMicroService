# Ignore build output and IDE configs
target/*
!target/*.jar
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Ignore git configs
.git/
.gitignore
.gitattributes

# Ignore Gemini and Antigravity specific files
.gemini/
.junie/
.agents/
GEMINI.md
GIT_COMMIT_CONVENTION.md

# Ignore local wrapper files and guides
mvnw
mvnw.cmd
.mvn/
HELP.md

# Ignore Docker files themselves
Dockerfile
.dockerignore
docker-compose*.yml
